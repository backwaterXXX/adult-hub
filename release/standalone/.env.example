# =============================================================================
# Adult Hub Standalone Environment Configuration
# =============================================================================
# Copy this file to '.env' before running docker compose:
#   cp .env.example .env
#
# Generate strong, random values for passwords and tokens:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# =============================================================================

# Standalone deployment marker
ADULT_HUB_STANDALONE=true

# Application version and container images
APP_VERSION=0.4.15
RESOLVER_IMAGE=ghcr.io/backwaterxxx/adult-hub-resolver:0.4.15
SYNC_IMAGE=ghcr.io/backwaterxxx/adult-hub-sync:0.4.15

# Database credentials
POSTGRES_DB=adulthub
POSTGRES_USER=adulthub
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Standalone persistent host storage paths
CONFIG_PATH=./config.yaml
DATA_DIR=./data
CACHE_DIR=./cache
MEDIA_DIR=./media

# Network bindings and ports
# Use 127.0.0.1 for server-only local access, or your private host LAN IP
# (e.g. 192.168.1.100) to allow access from other devices on your home network.
# Do NOT bind to 0.0.0.0 without a firewall or reverse proxy.
RESOLVER_BIND_IP=127.0.0.1
RESOLVER_PORT=8090
JELLYFIN_BIND_IP=127.0.0.1
JELLYFIN_PORT=8096

# Public URLs and access control
# When binding to LAN, set STREAM_PUBLIC_URL_TELEGRAM to your client-reachable resolver URL:
# e.g. http://192.168.1.100:8090
STREAM_PUBLIC_URL_TELEGRAM=
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
ADMIN_PUBLIC=false
# Legacy STANDALONE_* names (legacy, still accepted). They are used only when the
# canonical name above is unset or empty.
# STANDALONE_STREAM_PUBLIC_URL_TELEGRAM=
# STANDALONE_JELLYFIN_URL=http://jellyfin:8096
# STANDALONE_JELLYFIN_API_KEY=
# STANDALONE_ADMIN_PUBLIC=false
ADMIN_WRITE_TOKEN=CHANGE_ME_ADMIN_TOKEN

# Telegram MTProto API Credentials
# Obtain API ID and API Hash from https://my.telegram.org (under 'API development tools').
# Both are required before running: docker compose run --rm telegram-auth
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=/data/telegram.session
