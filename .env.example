# =============================================================================
# Adult-Hub Environment Configuration (.env)
# =============================================================================
# Source settings (providers, Telegram channels, domains, sections, intervals, retention)
# belong in config.yaml (see config.example.yaml).
# This .env file contains infrastructure settings, paths, and secrets only.
# =============================================================================

# Set this to your host's LAN IP before starting the stack.
HOST_IP=YOUR_LAN_IP

# HTTPS origin reachable by playback clients; /admin* must route to resolver.
RESOLVER_PUBLIC_URL=https://media.example.org

# Optional Telegram-specific HTTPS origin; empty uses RESOLVER_PUBLIC_URL.
STREAM_PUBLIC_URL_TELEGRAM=

# PostgreSQL 17 database connection URL.
# Containers reach it as host `postgres`; the host/tests use 127.0.0.1.
# Format: postgresql://username:password@hostname:5432/database
DATABASE_URL=postgresql://adulthub:SECRET@postgres:5432/adulthub
# Optional CREATEDB-capable connection for disposable backup restore tests.
# Point it at a maintenance database on the PostgreSQL server, not the primary catalog database.
BACKUP_RESTORE_DATABASE_URL=
# Tests and host tools use a separate database on localhost.
TEST_DATABASE_URL=postgresql://adulthub_test:SECRET@127.0.0.1:5432/adulthub_test

# Host directory for .strm/.nfo/.jpg files
MEDIA_PATH=./media/adult

# Optional YAML config path (default in containers: /config/config.yaml)
# CONFIG_PATH=/config/config.yaml

# Container paths below normally use the Compose defaults. Change these only
# when the corresponding mounted data layout or service name is customized.
DATA_DIR=/data
ADMIN_SOURCE_OVERRIDES_PATH=/data/admin-source-overrides.json
ADMIN_WORKER_CAPABILITIES_PATH=/data/cache/worker-capabilities.json
RESOLVER_API_URL=http://resolver:8090
# Maximum exact-message metadata checks per Telegram channel per scheduled run.
TELEGRAM_AVAILABILITY_CHECKS_PER_RUN=20
# Host-side media directory mounted at /media/adult inside both containers.
# MEDIA_DIR is the in-container path and remains /media/adult in Compose.

# Logging and concurrency
LOG_LEVEL=INFO
APP_VERSION=0.4.0
# Optional resolver-only tag; leave empty to use adult-hub-resolver:${APP_VERSION}.
RESOLVER_IMAGE=
# Optional sync-only tag; leave empty to use adult-hub-sync:${APP_VERSION}.
SYNC_IMAGE=
RESOLVER_CONCURRENCY_LIMIT=10

# Resolver cache TTL in seconds
CACHE_TTL_SECONDS=1500
MAX_CACHE_ENTRIES=2000

# Optional filtering and cleanup settings
HIDE_DEAD_STREAMS=true

# Telegram MTProto credentials (required only when Telegram is enabled)
# Register an application at https://my.telegram.org for an API ID and hash.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=/data/telegram.session
TELEGRAM_PARALLEL_STREAM_ENABLED=false
TELEGRAM_DOWNLOAD_WORKERS=3
TELEGRAM_DOWNLOAD_GLOBAL_WORKERS=6
TELEGRAM_READ_AHEAD_BYTES=33554432
TELEGRAM_STREAM_CACHE_BYTES=134217728
TELEGRAM_STREAM_CACHE_TTL_SECONDS=120
TELEGRAM_DOWNLOAD_BLOCK_BYTES=524288

# Jellyfin fast probing optimization for remote streams (reduces probe wait from ~110s to ~3s)
JELLYFIN_FFMPEG_FAST_PROBE=true
JELLYFIN_FFMPEG_ANALYZE_DURATION=5M
JELLYFIN_FFMPEG_PROBE_SIZE=10M

# Jellyfin API integration (library refresh and performer metadata)
JELLYFIN_URL=http://YOUR_LAN_IP:8096
JELLYFIN_API_KEY=

# Resolver admin panel
ENABLE_ADMIN=true
ADMIN_PUBLIC=false
# ADMIN_PUBLIC=true permits access through PUBLIC_DOMAIN, including write actions.
# Optional Bearer token for admin writes. Empty tokens enable writes without a token.
# All write actions require a browser Origin matching scheme, host and port.
ADMIN_WRITE_TOKEN=
# Deprecated fallback when ADMIN_WRITE_TOKEN is empty:
ADMIN_DUPLICATE_TOKEN=
PUBLIC_DOMAIN=media.example.org
# Exact resolver-side proxy peer IPs (add the Docker gateway for a host Caddy).
RESOLVER_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Optional Jellyfin-client PHASH intake. Disabled unless deliberately enabled.
# Decoder profiles must exactly match those emitted by the client.
PHASH_UPLOAD_ENABLED=false
PHASH_ACCEPTED_DECODER_PROFILES=resolver-ffmpeg-stash-v2
# Bounded server-side pHash extraction, independent of playback-device codecs.
PHASH_SERVER_BYTE_BUDGET=268435456
PHASH_SERVER_TIMEOUT_SECONDS=1200
PHASH_SERVER_BYTES_PER_SECOND=2097152
PHASH_SERVER_IDLE_BYTES_PER_SECOND=10000000
# Optional comma-separated Jellyfin user IDs for non-admin users; Jellyfin admins are accepted.
PHASH_ALLOWED_USER_IDS=

# Optional ThePornDB API token (fallback performer enrichment when PBC has no bio)
# Register at https://theporndb.net and generate token at /user/api-tokens
THEPORNDB_API_TOKEN=
THEPORNDB_API_KEY=

# Optional StashDB API key (performer enrichment: birth, country/nationality, HD portrait)
# Register at https://stashdb.org and generate key under Account Settings
STASHDB_API_KEY=
# Compatibility alias accepted by older integrations.
STASH_API_KEY=
STASHDB_API_URL=https://stashdb.org/graphql

# Bounded OSHASH metadata matching for all Telegram channels (disable with false).
TELEGRAM_FINGERPRINTS_ENABLED=true
TELEGRAM_OSHASH_BACKFILL_PER_RUN=200
# Frame-based pHash fallback runs after OSHASH finds no duration-compatible match.
TELEGRAM_PHASH_ENABLED=true
TELEGRAM_PHASH_BYTE_BUDGET=268435456
TELEGRAM_PHASH_TIMEOUT_SECONDS=1200
# Shared cap and pacing for automatic Telegram fingerprint range requests only.
# Player playback traffic is not included in this counter.
TELEGRAM_FINGERPRINT_DAILY_BYTE_BUDGET=10000000000
TELEGRAM_FINGERPRINT_MAX_BYTES_PER_SECOND=2097152
TELEGRAM_FINGERPRINT_USAGE_PATH=/data/cache/telegram-fingerprint-daily-usage.json

# Resolver backup pruning window (days) and daily backup time (local time).
# Consumed by the `backup` service (backup_scheduler.py) in Compose.
BACKUP_KEEP_DAYS=7
BACKUP_DAILY_AT=04:30

# Resolver watchdog (supervisor.py): restart the API after repeated failed
# health checks. The values below are the built-in defaults.
RESOLVER_WATCHDOG_INTERVAL_SECONDS=10
RESOLVER_WATCHDOG_TIMEOUT_SECONDS=4
RESOLVER_WATCHDOG_FAILURES=3
RESOLVER_WATCHDOG_STARTUP_GRACE_SECONDS=45

# Admin v2 issue thresholds (seconds): a queue that stays pending for longer
# than the first value, or a missing backup older than the second one, is
# reported as an issue.
ADMIN_V2_QUEUE_WARNING_SECONDS=3600
ADMIN_V2_BACKUP_WARNING_SECONDS=129600
