# =============================================================================
# Adult Hub Environment Configuration (.env)
# =============================================================================
# Common settings, infrastructure paths, and credentials.
#
# Channels are managed via the web Admin panel or optional config.yaml.
# Advanced knobs (concurrency, buffer budgets, cache TTLs, supervisor watchdog)
# use production defaults in code; see CONFIGURATION.md for overrides.
# =============================================================================

# --- Networking & Playback Routing ---
# Host LAN IP address reachable by local network playback clients.
HOST_IP=YOUR_LAN_IP

# Client-facing HTTPS origin serving playback stream links (.strm).
# Routes /admin* and /play* to the resolver service.
RESOLVER_PUBLIC_URL=https://media.example.org

# Exact public domain used to enforce browser Origin write validation.
PUBLIC_DOMAIN=media.example.org

# --- Storage Paths ---
# Host path storing generated .strm, .nfo, and .jpg library files.
# MEDIA_DIR is the canonical variable; MEDIA_PATH is supported as a backward-compatible alias.
MEDIA_PATH=./media/adult

# --- Database Connection ---
# PostgreSQL 17 connection URL.
# Canonical connection string. Standalone internal DB service is 'database' (aliased as 'postgres').
# Production external host is 'postgres' (or 127.0.0.1).
# Standalone setup.sh automatically writes STANDALONE_DATABASE_URL if DATABASE_URL is unset.
DATABASE_URL=postgresql://adulthub:SECRET@database:5432/adulthub

# Optional: Maintenance connection for disposable backup-restore verification tests.
BACKUP_RESTORE_DATABASE_URL=

# --- Access Control & Security ---
# Bearer token for Admin write operations (adding/modifying channels, manual retries).
# Recommended: Set a strong random secret. If left empty, local admin mutations do not
# require bearer token authorization (origin checks still apply).
# Required when exposing the admin panel through a public domain with write capabilities.
ADMIN_WRITE_TOKEN=

# Enable to permit Admin access through the public domain (default: false).
# Can also be configured via STANDALONE_ADMIN_PUBLIC in standalone mode.
# When commented out or unset, defaults to false (admin routes accessible locally only).
# ADMIN_PUBLIC=false

# --- Telegram Provider Credentials ---
# Register your application at https://my.telegram.org to obtain an API ID and hash.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: Channel mapping / hint overrides for Telegram sources
TELEGRAM_SIGNATURE_CHANNEL=
TELEGRAM_CHANNEL_NAME_HINTS=

# --- Jellyfin Integration (Optional) ---
# Enables library refresh notifications and performer image sync.
JELLYFIN_URL=http://YOUR_LAN_IP:8096
JELLYFIN_API_KEY=

# --- Metadata Providers (Optional) ---
# StashDB GraphQL API key for actor bio and portrait enrichment (https://stashdb.org).
STASHDB_API_KEY=

# ThePornDB API token for performer metadata enrichment (https://theporndb.net).
THEPORNDB_API_TOKEN=

# --- General Runtime ---
TZ=Europe/Warsaw
LOG_LEVEL=INFO
